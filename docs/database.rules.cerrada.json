{
  "rules": {
    // REGLAS CERRADAS POR ROL (etapa 3). Se pegan en Firebase > Realtime Database > Reglas
    // (o `firebase deploy --only database` copiando este contenido a database.rules.json)
    // SOLO cuando /api/login-estado muestre "pendientes": 0. Ver SECURITY.md.
    //
    // gerencia = la cuenta de Firebase cuyo rol figura en userRoles/{uid}/role (lo escribe
    // únicamente el Worker, que usa el secreto de la base y no pasa por estas reglas).
    "cajaData":              { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "cierresCaja":           { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "cierresMensualesData":  { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "liquidacionConfig":     { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "legajoData":            { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "evaluacionesData":      { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "faltasData":            { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "loginAuth":             { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    "loginPasswords":        { ".read": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'", ".write": "root.child('userRoles').child(auth.uid).child('role').val() === 'gerencia'" },
    // Cada persona puede leer solo su propio rol; nadie escribe desde la app.
    "userRoles": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    // El resto de la base sigue como hasta ahora: cualquier persona con sesión. En RTDB un permiso
    // dado en un nivel superior no se puede quitar en los hijos, por eso la excepción va acá
    // (los nodos de arriba quedan fuera de este comodín).
    "$otro": {
      ".read":  "auth != null && $otro !== 'cajaData' && $otro !== 'cierresCaja' && $otro !== 'cierresMensualesData' && $otro !== 'liquidacionConfig' && $otro !== 'legajoData' && $otro !== 'evaluacionesData' && $otro !== 'faltasData' && $otro !== 'loginAuth' && $otro !== 'loginPasswords' && $otro !== 'userRoles' && $otro !== 'loginDiag'",
      ".write": "auth != null && $otro !== 'cajaData' && $otro !== 'cierresCaja' && $otro !== 'cierresMensualesData' && $otro !== 'liquidacionConfig' && $otro !== 'legajoData' && $otro !== 'evaluacionesData' && $otro !== 'faltasData' && $otro !== 'loginAuth' && $otro !== 'loginPasswords' && $otro !== 'userRoles' && $otro !== 'loginDiag'"
    }
  }
}
